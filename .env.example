# Optional email delivery through Resend
RESEND_API_KEY=
MIRAI_LEAD_EMAIL=
MIRAI_FROM_EMAIL=

# WhatsApp number in international format, digits preferred, e.g. 2010XXXXXXXX
MIRAI_WHATSAPP=

# Static-site email relay (GitHub Pages): FormSubmit AJAX endpoint + optional CC, and an optional
# owner WhatsApp notification URL with a {text} placeholder (e.g. CallMeBot)
MIRAI_FORM_ENDPOINT=
MIRAI_FORM_CC=
MIRAI_NOTIFY_URL=

# Production site URL for canonical/robots/sitemap
SITE_URL=https://miraisolutions.net

PORT=3000
