# systemd unit for a VPS: sudo cp mirai.service /etc/systemd/system/ && sudo systemctl enable --now mirai
[Unit]
Description=Mirai Solutions website
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/mirai
EnvironmentFile=/var/www/mirai/.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
